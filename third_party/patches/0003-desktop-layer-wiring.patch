+                wide_phase <= 3'd0;
             end
             
             RECV_PARAM: if (rx_valid) begin
@@ -305,6 +336,52 @@ always @(posedge clk) begin
                         kbd_data <= rx_data;
                         kbd_data_valid <= 1;
                     end
+                    // TinyTang: the desktop layer.  Three additive commands:
+                    //   0x13 x[7:0] y[7:0]      move the layer's write cursor
+                    //   0x14 <5 bytes per cell>  write cells from the cursor,
+                    //                           advancing across the grid
+                    //   0x15 x[7:0]              x[0]: enable the layer
+                    // A cell is ch, fg_hi, fg_lo, bg_hi, bg_lo, with the
+                    // colour 15-bit BGR5 in the low 15 bits of the pair.
+                    'h13: begin
+                        case (data_cnt)
+                            0: wide_cx <= rx_data[6:0];
+                            1: wide_cy <= rx_data[5:0];
+                            default: ;
+                        endcase
+                    end
+                    'h14: begin
+                        /* The phase is the byte's position within the cell.
+                         * It is reset when the frame starts (see RECV_CMD)
+                         * rather than inferred from data_cnt, which would
+                         * need a divider; every cell is five bytes, so a
+                         * frame leaves the phase back at zero anyway.
+                         *
+                         * It must be the phase for *this* byte, not the one
+                         * just computed.  Using the pre-update value shifts
+                         * the whole cell by one, which puts the glyph in the
+                         * foreground byte and scrambles the screen. */
+                        case (wide_phase)
+                            0: wide_ch  <= rx_data[6:0];
+                            1: wide_fgh <= rx_data;
+                            2: wide_fg  <= {wide_fgh[6:0], rx_data};
+                            3: wide_bgh <= rx_data;
+                            4: begin
+                                wide_bg <= {wide_bgh[6:0], rx_data};
+                                wide_we <= 1;
+                                // Advance, wrapping to the next row so a whole
+                                // screen can be painted as one run.
+                                if (wide_cx >= 7'd79) begin
+                                    wide_cx <= 0;
+                                    if (wide_cy < 6'd44) wide_cy <= wide_cy + 6'd1;
+                                end else
+                                    wide_cx <= wide_cx + 7'd1;
+                            end
+                            default: ;
+                        endcase
+                        wide_phase <= (wide_phase == 3'd4) ? 3'd0 : wide_phase + 3'd1;
+                    end
+                    'h15: wide_on <= rx_data[0];
                     default: begin
                         // unknown command: consume all data and return
                     end
diff --git a/src/nes2hdmi.sv b/src/nes2hdmi.sv
index 2937307..ccedb25 100644
--- a/src/nes2hdmi.sv
+++ b/src/nes2hdmi.sv
@@ -20,6 +20,15 @@ module nes2hdmi (
     output [7:0] overlay_y,
     input [14:0] overlay_color, // BGR5
 
+    // TinyTang: the desktop layer's write port (main logic clock) and enable.
+    input        wide_we,
+    input [6:0]  wide_x,
+    input [5:0]  wide_y,
+    input [6:0]  wide_ch,
+    input [14:0] wide_fg,
+    input [14:0] wide_bg,
+    input        wide_on,
+
 	// video clocks
 	input clk_pixel,
 	input clk_5x_pixel,
@@ -203,10 +212,40 @@ always @(posedge clk_pixel) begin
 
 end
 
+// TinyTang: the desktop layer, presented at 2x across the whole raster.
+//
+// It is composited here rather than in the NES pixel domain, because it is
+// 640x360 and the picture the scaler above produces is 256x224: the layer
+// cannot live inside that.  When it is up it replaces the output entirely,
+// bars included, which is what "full screen" means for a desktop.
+wire [14:0] wide_color;
+
+textdisp_wide u_wide (
+    .clk(clk), .hclk(clk_pixel),
+    .we(wide_we), .wx(wide_x), .wy(wide_y),
+    .wch(wide_ch), .wfg(wide_fg), .wbg(wide_bg),
+    .cx(cx), .cy(cy), .color(wide_color)
+);
+
+// The enable is a register in the main logic clock; bring it across before it
+// decides anything in this one.
+reg wide_on_r, wide_on_rr;
+always @(posedge clk_pixel) begin
+    wide_on_r  <= wide_on;
+    wide_on_rr <= wide_on_r;
+end
+
 // calc rgb value to hdmi
+//
+// The layer is shown when the overlay is asserted as well as enabled, so the
+// existing overlay control still hides it: `nesload` clears the overlay before
+// releasing a core, which is what hands the screen over to the game, and the
+// desktop is hidden by that same byte with nothing new to keep in step.
 reg [23:0] NES_PALETTE [0:63];
 always @(posedge clk_pixel) begin
-    if (active) begin
+    if (wide_on_rr && overlay)
+        rgb <= {wide_color[4:0],3'b0,wide_color[9:5],3'b0,wide_color[14:10],3'b0};                 // BGR5 to RGB8
+    else if (active) begin
         if (overlay)
             rgb <= {overlay_color[4:0],3'b0,overlay_color[9:5],3'b0,overlay_color[14:10],3'b0};       // BGR5 to RGB8
         else
