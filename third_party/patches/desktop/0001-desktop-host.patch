+                        response_ack <= response_req;
+                    end else send_idx <= send_idx + 1;
+                end
+            end
+`endif
+
             SEND_CONFIG_STRING: begin
                 if (tx_ready && ~tx_valid) begin
                     tx_data <= CONF_STR[8*(STR_LEN - send_idx - 1) +: 8];
