diff --git a/keyboards/keychron/common/wireless/lpm.c b/keyboards/keychron/common/wireless/lpm.c
index 5f4d622..5966c9c 100644
--- a/keyboards/keychron/common/wireless/lpm.c
+++ b/keyboards/keychron/common/wireless/lpm.c
@@ -336,6 +336,22 @@ void lpm_task(void) {
     }
 
     if (usb_power_connected()) {
+#ifdef TANG_MODE
+        /* TinyTang: USB is stopped deliberately and its data pins carry the
+         * keyboard link instead.  This branch is what defeated that.  Its test
+         * is `USBD1.state == USB_STOP`, which is exactly the state usbStop()
+         * leaves behind, and init_usb_driver() does not merely initialise --
+         * it ends with usbStart() and usbConnectBus(), so USB came back up,
+         * PA11/PA12 went back to being OTG alternate functions and the D+
+         * pull-up was switched on again.  A pin owned by the OTG core ignores
+         * every write to its output register, so from that moment the link
+         * could not drive its own line at all: it sat high and the Tang saw a
+         * keyboard that was either silent or not plugged in.  The symptom on a
+         * host is a full-speed device that never answers enumeration, because
+         * the peripheral is powered and connected but nothing services it.
+         * Leaving USB stopped is the entire point of Tang mode. */
+        return;
+#else
         if (USBD1.state == USB_STOP) {
             /* TODO: Do we need this? */
             usb_event_queue_init();
@@ -343,6 +359,7 @@ void lpm_task(void) {
         }
         /* No need to enter low power mode when USB power is connected */
         return;
+#endif
     }
 
     switch (get_transport()) {
diff --git a/keyboards/keychron/k2_he/board.h b/keyboards/keychron/k2_he/board.h
