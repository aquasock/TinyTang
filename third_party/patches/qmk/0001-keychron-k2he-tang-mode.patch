@@ -21,6 +21,31 @@
 // clang-format off
 
 /* Set GPIOA_SWDIO to INPUT & PIN_PUPDR_PULLUP to avoid FLOATING */
+
+/* TinyTang's keyboard link takes the USB data pins for itself.  PA12 (D+) is
+ * the keyboard's transmit line and PA11 (D-) is the Tang's return line, not
+ * yet used; both are ordinary GPIOs on the STM32F401, and the OTG
+ * peripheral's internal pull-up disappears with the peripheral, so nothing
+ * external has to be defeated.  TANG_MODE is a build flag rather than a
+ * runtime choice because this mode is applied at board init, before USB is
+ * started: taking the pins back from underneath a live USB peripheral is not
+ * something the firmware should attempt. */
+#ifdef TANG_MODE
+#    define K2HE_GPIOA_OTG_MODER  (PIN_MODE_OUTPUT(GPIOA_OTG_FS_DP) |      \
+                                   PIN_MODE_INPUT(GPIOA_OTG_FS_DM) |       \
+                                   PIN_MODE_INPUT(GPIOA_OTG_FS_ID))
+#    define K2HE_GPIOA_OTG_PUPDR  (PIN_PUPDR_FLOATING(GPIOA_OTG_FS_DP) |   \
+                                   PIN_PUPDR_FLOATING(GPIOA_OTG_FS_DM) |   \
+                                   PIN_PUPDR_FLOATING(GPIOA_OTG_FS_ID))
+#else
+#    define K2HE_GPIOA_OTG_MODER  (PIN_MODE_ALTERNATE(GPIOA_OTG_FS_ID) |   \
+                                   PIN_MODE_ALTERNATE(GPIOA_OTG_FS_DM) |   \
+                                   PIN_MODE_ALTERNATE(GPIOA_OTG_FS_DP))
+#    define K2HE_GPIOA_OTG_PUPDR  (PIN_PUPDR_FLOATING(GPIOA_OTG_FS_ID) |   \
+                                   PIN_PUPDR_FLOATING(GPIOA_OTG_FS_DM) |   \
+                                   PIN_PUPDR_FLOATING(GPIOA_OTG_FS_DP))
+#endif
+
 #undef VAL_GPIOA_MODER
 #define VAL_GPIOA_MODER             (PIN_MODE_INPUT(GPIOA_BUTTON) |         \
                                      PIN_MODE_INPUT(GPIOA_PIN1) |           \
@@ -32,9 +57,7 @@
                                      PIN_MODE_ALTERNATE(GPIOA_L3GD20_SDI) | \
