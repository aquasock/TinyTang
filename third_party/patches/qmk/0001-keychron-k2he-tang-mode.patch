diff --git a/keyboards/keychron/k2_he/k2_he.c b/keyboards/keychron/k2_he/k2_he.c
index 3ac31eb..bb0f58f 100644
--- a/keyboards/keychron/k2_he/k2_he.c
+++ b/keyboards/keychron/k2_he/k2_he.c
@@ -57,6 +57,22 @@ void keychron_task_kb(void) {
 
 #ifdef LK_WIRELESS_ENABLE
 bool lpm_is_kb_idle(void) {
+#ifdef TANG_MODE
+    /* TinyTang: this keyboard is not a keyboard here, it is the Tang's input
+     * device, and it has to answer every time the link is polled.  The stock
+     * test asks "has anyone touched me lately" and answers yes as soon as the
+     * power-on indicator finishes -- three seconds after boot -- and the
+     * wireless task then parks the CPU in lpm_standby(), which switches the
+     * clock to HSI, turns the HSE off and waits on __WFI().  The link is
+     * driven from the tail of the main loop, so it stopped running almost
+     * immediately after starting, leaving the transmit line idling high: from
+     * the Tang that is indistinguishable from a keyboard that was never
+     * plugged in, and nothing about it looks like a fault from this side.
+     * Tang firmware never idles; the link is the reason the keyboard is
+     * powered at all. */
+    return false;
+#else
     return power_on_indicator_timer == 0 && !backlight_indicator_is_active();
+#endif
 }
 #endif
diff --git a/tmk_core/protocol/chibios/usb_main.c b/tmk_core/protocol/chibios/usb_main.c
