--- a/tmk_core/protocol/chibios/usb_main.c
+++ b/tmk_core/protocol/chibios/usb_main.c
@@ -390,6 +390,22 @@ void update_usb_report_interval(USBDriver *usbp, uint8_t interval) {
 #endif
 
 void init_usb_driver(USBDriver *usbp) {
+#ifdef TANG_MODE
+    /* TinyTang: the keyboard's USB data pins carry the link instead, so USB
+     * must not come up at all.  This function is the single place that does
+     * come up -- it ends in usbStart() and usbConnectBus() -- and it is called
+     * from QMK's USB thread shortly after boot, which is after
+     * keyboard_post_init_user() has already taken PA11/PA12 as GPIOs for the
+     * link.  Starting USB here silently handed them back to the OTG core, and
+     * a pin owned by the OTG core ignores every write to its output register,
+     * so the link sent a short burst and then went quiet for good.
+     *
+     * From the Tang that looked like a hundred or so frames followed by
+     * silence: a healthy-looking start and no diagnosis.  Nothing downstream
+     * of this needs USB -- the link is the keyboard's only host. */
+    (void)usbp;
+    return;
+#else
     for (int i = 0; i < USB_ENDPOINT_IN_COUNT; i++) {
         usb_endpoint_in_init(&usb_endpoints_in[i]);
         usb_endpoint_in_start(&usb_endpoints_in[i]);
@@ -413,6 +429,7 @@ void init_usb_driver(USBDriver *usbp) {
     wait_ms(50);
     usbStart(usbp, &usbcfg);
     usbConnectBus(usbp);
+#endif
 }
 
