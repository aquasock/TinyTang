  * it). Input and timers keep running. Used for bounded drawing batches. */
 void td_frame_hold(uint32_t timeout_ms);
 
+  /* A local display: a port that draws the screen itself, from cells, in
+ * place of a terminal on the HAL -- an LCD, or the text layer of an FPGA.
+ * Set before td_init (NULL, the default, is a terminal). The screen is then
+ * cols x rows, no escape sequences are written to the HAL for the primary
+ * display and no size is asked for; the HAL's read_byte still brings input.
+ * After each composed frame frame() is called. td_display_screen() is what
+ * the screen should show, and td_display_shown() is the port's own record of
+ * what it does show, which the port keeps as it draws and TinyDesk only
+ * invalidates (td_full_redraw, a resize). lock / unlock (both optional)
+ * bracket each composition, so a port that draws from another task can hold
+ * the screen still while it reads it. Saves the escape-sequence round trip
+ * and the terminal emulator a port would otherwise run to get cells back. */
+typedef struct
+{
+    int cols, rows;
+    void (*frame)(void *ctx);
+    void (*lock)(void *ctx);
+    void (*unlock)(void *ctx);
+    void *ctx;
+} td_local_display_t;
+void td_set_local_display(const td_local_display_t *display);
+const td_buffer_t *td_display_screen(void);
+td_buffer_t *td_display_shown(void);
+
   /* Milliseconds from the HAL. */
 uint32_t td_millis(void);
 
