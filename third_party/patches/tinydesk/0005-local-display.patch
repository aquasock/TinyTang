diff --git a/tests/test_local_display.c b/tests/test_local_display.c
new file mode 100644
index 0000000..4610e92
--- /dev/null
+++ b/tests/test_local_display.c
@@ -0,0 +1,168 @@
+/*
+ * test_local_display.c - a port that draws the screen itself (td_set_local_display):
+ * the size is the display's, nothing is written to the HAL, every change
+ * is a frame the port is told of, the screen holds what was composed, the
+ * port's record of what it shows is invalidated only by a full redraw, the
+ * composition is bracketed by the port's lock, and input after a long
+ * silence (which resyncs a terminal) does not redraw a local display.
+ */
+#include "td_test.h"
+#include "tinydesk/td.h"
+
+static uint32_t s_now = 1000;
+static int s_written;
+static const char *s_in = "";
+
+static int fake_read(void *ctx)
+{
+    (void)ctx;
+    return *s_in ? (unsigned char)*s_in++ : -1;
+}
+static int fake_write(void *ctx, const uint8_t *buf, int len)
+{
+    (void)ctx;
+    (void)buf;
+    s_written += len;
+    return len;
+}
+static uint32_t fake_millis(void *ctx)
+{
+    (void)ctx;
+    return s_now;
+}
+static void fake_sleep(void *ctx, uint32_t ms)
+{
+    (void)ctx;
+    s_now += ms;
+}
+static const td_hal_t s_hal = {fake_read, fake_write, fake_millis, fake_sleep, NULL};
+
+static int s_frames, s_locks, s_unlocks;
+static bool s_locked, s_framed_while_locked;
+static bool s_shown_was_invalid;
+
+static void on_lock(void *ctx)
+{
+    (void)ctx;
+    s_locks++;
+    s_locked = true;
+}
+static void on_unlock(void *ctx)
+{
+    (void)ctx;
+    s_unlocks++;
+    s_locked = false;
+}
+/* The port: note whether its record was invalidated, then show the screen. */
+static void on_frame(void *ctx)
+{
+    (void)ctx;
+    s_frames++;
+    if (s_locked)
+        s_framed_while_locked = true;
+    td_buffer_t *shown = td_display_shown();
+    const td_buffer_t *screen = td_display_screen();
+    s_shown_was_invalid = shown->cells[0].ch == TD_CH_INVALID;
+    for (int i = 0; i < screen->cols * screen->rows; i++)
+        shown->cells[i] = screen->cells[i];
+}
+
+static td_window_t *s_win;
+static char s_text[16] = "hello";
+static void on_draw(td_window_t *win, int cw, int ch)
+{
+    (void)win;
+    (void)ch;
+    td_textn(0, 0, s_text, cw, 7, 0, 0);
+}
+
+static void step(uint32_t ms)
+{
+    s_now += ms;
+    td_step();
+}
+
+/* Whether the screen holds text at some row, anywhere along it. */
+static bool screen_has(const char *text)
+{
+    const td_buffer_t *b = td_display_screen();
+    int n = (int)strlen(text);
+    for (int y = 0; y < b->rows; y++)
+        for (int x = 0; x + n <= b->cols; x++)
+        {
+            int k = 0;
+            while (k < n && b->cells[y * b->cols + x + k].ch == (uint32_t)(unsigned char)text[k])
+                k++;
+            if (k == n)
+                return true;
+        }
+    return false;
+}
+
+int main(void)
+{
+    const td_local_display_t display = {
+        .cols = 80, .rows = 45, .frame = on_frame, .lock = on_lock, .unlock = on_unlock, .ctx = NULL};
+    td_set_local_display(&display);
+    CHECK_EQ(td_init(&s_hal), 0);
+
+    /* The display's size, asked of nobody, and nothing written. */
+    CHECK_EQ(td_stats()->cols, 80);
+    CHECK_EQ(td_stats()->rows, 45);
+    CHECK_EQ(td_display_screen()->cols, 80);
+    CHECK_EQ(td_display_screen()->rows, 45);
+    CHECK_EQ(s_written, 0);
+
+    td_window_desc_t d = {.title = "Local", .rect = td_rect(2, 2, 30, 6), .on_draw = on_draw};
+    s_win = td_win_create(&d);
+    CHECK(s_win != NULL);
+
+    /* The first frame: the port is told, its record starts invalid so it
+     * draws everything, and the window is on the screen. */
+    step(10);
+    CHECK_EQ(s_frames, 1);
+    CHECK(s_shown_was_invalid);
+    CHECK(screen_has("hello"));
+    CHECK_EQ(s_written, 0);
+    /* The composition was locked, and the port was not called inside it. */
+    CHECK(s_locks >= 1);
+    CHECK_EQ(s_locks, s_unlocks);
+    CHECK(!s_framed_while_locked);
+
+    /* Nothing changed: no frame. */
+    int before = s_frames;
+    step(10);
+    step(10);
+    CHECK_EQ(s_frames, before);
+
+    /* A change: one frame, and the port's record was kept, not invalidated. */
+    snprintf(s_text, sizeof s_text, "world");
+    td_win_invalidate(s_win);
+    step(10);
+    CHECK_EQ(s_frames, before + 1);
+    CHECK(!s_shown_was_invalid);
+    CHECK(screen_has("world"));
+    CHECK(!screen_has("hello"));
+
+    /* A full redraw invalidates the port's record, so every cell goes again. */
+    before = s_frames;
+    td_full_redraw();
+    step(10);
+    CHECK_EQ(s_frames, before + 1);
+    CHECK(s_shown_was_invalid);
+
+    /* Input after a long silence resyncs a terminal; a local display has
+     * nothing to resync, so it draws nothing extra and writes nothing. */
+    s_now += 600000;
+    s_shown_was_invalid = false;
+    s_in = "a";
+    step(10);
+    step(10);
+    CHECK(!s_shown_was_invalid);   /* a frame for the key, perhaps, but not everything */
+    CHECK_EQ(s_written, 0);
+
+    /* No terminal to restore. */
+    td_shutdown();
+    CHECK_EQ(s_written, 0);
+    return TD_TEST_RESULT();
+}
