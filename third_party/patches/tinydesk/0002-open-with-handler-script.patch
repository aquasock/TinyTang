+/* Files with a handler: opening "name.ext" (double-click or Enter in the
+ * Files app or on the desktop) runs the script <home>/scripts/open/ext.tdsh,
+ * extension in lower case, in the Terminal with FILE set to the file's shell
+ * path, when that script exists. Returns false, doing nothing, when there is
+ * no such script, so the caller opens the file as it otherwise would. */
+bool td_open_with_handler(const char *path);
