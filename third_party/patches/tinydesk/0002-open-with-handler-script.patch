+bool td_open_with_handler(const char *path)
+{
+    const char *name = strrchr(path, '/');
+    name = name ? name + 1 : path;
+    const char *dot = strrchr(name, '.');
+    if (!dot || dot == name || !dot[1] || strlen(dot + 1) > 15)
+        return false;
+    char ext[16];
+    size_t n = 0;
+    for (const char *c = dot + 1; *c; c++)
+        ext[n++] = (*c >= 'A' && *c <= 'Z') ? (char)(*c - 'A' + 'a') : *c;
+    ext[n] = '\0';
+    if (strcmp(ext, TD_SCRIPT_EXT + 1) == 0)
+        return false;           /* scripts open in the Editor and Run from the menu */
+
+    char handler[TD_PATH_MAX];
+    if (snprintf(handler, sizeof(handler), "%s/scripts/open/%s%s", td_home_dir(), ext,
+                 TD_SCRIPT_EXT) >= (int)sizeof(handler))
+        return false;
+    const td_fs_ops_t *fs = td_sysinfo()->fs;
+    if (!fs->exists || !fs->exists(handler))
+        return false;
+
+    const char *file = td_shell_path(path);
+    char cmd[2 * TD_PATH_MAX + 32];
+    if (strchr(file, '"') ||
+        snprintf(cmd, sizeof(cmd), "FILE=\"%s\"; tdsh run \"%s\"", file,
+                 td_shell_path(handler)) >= (int)sizeof(cmd))
+    {
+        td_msgbox("Open", "This file name cannot be passed to the shell.", "OK", NULL, NULL);
+        return true;
+    }
+    td_terminal_run(cmd);
+    return true;
+}
