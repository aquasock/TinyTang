diff --git a/CMakeLists.txt b/CMakeLists.txt
index 954cb8c..aab24b2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -42,6 +42,12 @@ add_library(tinydesk_core STATIC
 target_include_directories(tinydesk_core PUBLIC include)
 set_target_properties(tinydesk_core PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON C_EXTENSIONS OFF)
 target_compile_options(tinydesk_core PRIVATE ${TD_WARNINGS})
+# The start menu and the app registry are sized by TD_MAX_APPS, and a desktop
+# that registers more apps than it can show loses the tail of its start menu.
+# The host suite builds with the capacity of the largest port that carries
+# TinyDesk (TinyTang, 19 apps), so test_wm exercises the menu at that size
+# instead of at the 16-slot default, which is too small to reach the bug.
+target_compile_definitions(tinydesk_core PUBLIC TD_MAX_APPS=24)
 
 # ------------------------------------------------ protocols (MQTT, Modbus)
 add_library(tinydesk_proto STATIC
