diff --git a/tests/test_wm.c b/tests/test_wm.c
index cf5f0ee..d1efbaa 100644
--- a/tests/test_wm.c
+++ b/tests/test_wm.c
@@ -278,6 +278,75 @@ static void test_icons_and_hover(void)
     CHECK(!td_wm_needs_redraw());
 }
 
+/* The start menu's tail: a desktop holding more apps than the menu can show
+ * must still reach "Redraw screen" and "Exit".  Exit is the only caller of
+ * td_quit() there is, so an entry that cannot be chosen is a desktop that
+ * cannot be left; and the callback that chooses it is handed the index of the
+ * item as drawn, so it has to count the apps the menu actually placed rather
+ * than the ones the registry holds. */
+static void test_start_menu_tail(void)
+{
+    static td_buffer_t back;
+    static char names[TD_MAX_APPS][24];
+    static td_app_t apps[TD_MAX_APPS];
+
+    td_wm_init(80, 25);
+    /* Earlier tests registered two apps; fill the registry to nineteen, the
+     * number TinyTang registers, so the menu deals with a list it has to
+     * clip at the default size. */
+    for (int i = td_app_count(); i < 19 && i < TD_MAX_APPS; i++)
+    {
+        snprintf(names[i], sizeof(names[i]), "Tail app %d", i);
+        apps[i].name = names[i];
+        apps[i].launch = launch_app;
+        apps[i].icon = NULL;
+        CHECK_EQ(td_app_register(&apps[i]), 0);
+    }
+    CHECK_EQ(td_app_count(), 19);
+
+    /* The whole list is on the menu: the last app, "Redraw screen" and
+     * "Exit" are all drawn.  A registered app that is silently dropped is
+     * what put the tail -- including Exit -- out of reach. */
+    td_wm_toggle_start_menu();
+    td_wm_compose(&back);
+    CHECK(find_text(&back, "Tail app 18") >= 0);
+    CHECK(find_text(&back, "Redraw screen") >= 0);
+    CHECK(find_text(&back, "Exit") >= 0);
+
+    /* Both ends of the app section choose apps, not the entries after them: a
+     * menu whose app section is shorter than the registry, or whose offset is
+     * computed from the wrong count, launches nothing here or quits. */
+    s_launches = 0;
+    key(TD_KEY_HOME, 0);
+    key(TD_KEY_ENTER, 0);
+    CHECK_EQ(s_launches, 1);
+    CHECK(td_step());
+
+    td_wm_toggle_start_menu();
+    key(TD_KEY_HOME, 0);
+    for (int i = 0; i < 18; i++)
+        key(TD_KEY_DOWN, 0);
+    key(TD_KEY_ENTER, 0);
+    CHECK_EQ(s_launches, 2);
+    CHECK(td_step());
+
+    /* "Redraw screen" is the other fixed entry: it redraws and does not
+     * quit, which is what an off-by-one in the tail's offset gets wrong. */
+    td_wm_toggle_start_menu();
+    key(TD_KEY_END, 0);
+    key(TD_KEY_UP, 0);
+    const uint32_t frames = td_stats()->frames;
+    key(TD_KEY_ENTER, 0);
+    CHECK(td_step());
+    CHECK(td_stats()->frames > frames);
+
+    /* END is the last item, which is the one that quits. */
+    td_wm_toggle_start_menu();
+    key(TD_KEY_END, 0);
+    key(TD_KEY_ENTER, 0);
+    CHECK(!td_step());
+}
+
 int main(void)
 {
     td_init(&s_hal);   /* no size answer: falls back to 80x25 */
@@ -366,5 +435,6 @@ int main(void)
     test_icons_and_hover();
     test_icon_labels_utf8();
     test_drag_and_drop();
+    test_start_menu_tail();
     return TD_TEST_RESULT();
 }
