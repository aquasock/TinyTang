 #include "tinydesk/td.h"
@@ -313,6 +313,57 @@ static void test_list(void)
     CHECK_EQ(cell(r.x + 1, r.y)->ch, 'i');
 }
 
+static int s_slider_calls;
+static void on_slider(td_widget_t *w, void *user)
+{
+    (void)w;
+    (void)user;
+    s_slider_calls++;
+}
+
+static void test_slider(void)
+{
+    td_window_t *w = new_window();
+    td_widget_t *s = td_slider(w, 0, 0, 20, 5, on_slider, NULL);
+    td_rect_t r = td_widget_rect(s);
+    s_slider_calls = 0;
+
+    CHECK(s->focusable);
+    td_slider_set(s, 100);
+    CHECK_EQ(s->value, 100);
+    CHECK_EQ(s_slider_calls, 0);               /* setting is not a change */
+    td_slider_set(s, 250);
+    CHECK_EQ(s->value, 100);                   /* clamped */
+
+    td_widget_focus(s);
+    key(TD_KEY_LEFT, 0);
+    CHECK_EQ(s->value, 95);
+    CHECK_EQ(s_slider_calls, 1);
+    key(TD_KEY_RIGHT, 0);
+    key(TD_KEY_RIGHT, 0);                      /* already at the end */
+    CHECK_EQ(s->value, 100);
+    CHECK_EQ(s_slider_calls, 2);
+    key(TD_KEY_HOME, 0);
+    CHECK_EQ(s->value, 0);
+    key(TD_KEY_LEFT, 0);
+    CHECK_EQ(s->value, 0);
+    CHECK_EQ(s_slider_calls, 3);
+    key(TD_KEY_END, 0);
+    CHECK_EQ(s->value, 100);
+
+    /* A click takes the cell under the pointer: of twenty, the first is 5
+     * and the tenth 50, and a drag follows the pointer. */
+    click(r.x, r.y);
+    CHECK_EQ(s->value, 5);
+    click(r.x + 9, r.y);
+    CHECK_EQ(s->value, 50);
+    mouse(TD_MOUSE_PRESS, TD_BUTTON_LEFT, r.x + 9, r.y);
+    mouse(TD_MOUSE_DRAG, TD_BUTTON_LEFT, r.x + 19, r.y);
+    CHECK_EQ(s->value, 100);
+    mouse(TD_MOUSE_RELEASE, TD_BUTTON_LEFT, r.x + 19, r.y);
+    td_win_close(w);
+}
+
