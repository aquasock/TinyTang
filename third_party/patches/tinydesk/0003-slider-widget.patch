+/* Move a slider to `percent`, on its step, and tell the app if it moved. */
+static void slider_move(td_widget_t *w, int percent)
+{
+    int step = w->maxlen > 0 ? w->maxlen : 1;
+    percent = clamp((percent + step / 2) / step * step, 0, 100);
+    if (percent == w->value)
+        return;
+    w->value = percent;
+    activate(w);
+}
+
+/* The value of the cell under x: the first cell is one cell's worth, the
+ * last is 100, so the bar drawn afterwards ends at the cell clicked. */
+static void slider_track(td_widget_t *w, int x)
+{
+    td_rect_t r = local_rect(w);
+    if (r.w <= 0)
+        return;
+    int cell = clamp(x - r.x, 0, r.w - 1);
+    slider_move(w, (cell + 1) * 100 / r.w);
+}
+
+static bool slider_key(td_widget_t *w, const td_event_t *ev)
+{
+    int step = w->maxlen > 0 ? w->maxlen : 1;
+    switch (ev->key)
+    {
+    case TD_KEY_LEFT:
+        slider_move(w, w->value - step);
+        return true;
+    case TD_KEY_RIGHT:
+        slider_move(w, w->value + step);
+        return true;
+    case TD_KEY_HOME:
+        slider_move(w, 0);
+        return true;
+    case TD_KEY_END:
+        slider_move(w, 100);
+        return true;
+    default:
+        return false;
+    }
+}
