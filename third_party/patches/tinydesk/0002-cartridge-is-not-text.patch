+/* A cartridge, by extension.  It is binary, so the Editor is never the right
+ * thing to open one with: it would show a file it cannot render and save over
+ * it.  Cartridges are started from the TinyNES app's Library. */
+static bool is_cartridge(const char *path)
+{
+    const char *dot = path ? strrchr(path, '.') : NULL;
+    if (!dot || dot == path)
+        return false;
+    ++dot;
+    return (dot[0] == 'n' || dot[0] == 'N') && (dot[1] == 'e' || dot[1] == 'E') &&
+           (dot[2] == 's' || dot[2] == 'S') && dot[3] == '\0';
+}
+
 void td_editor_open(const char *path)
 {
+    if (path && is_cartridge(path))
+    {
+        td_msgbox("Open", "Cartridges start from the TinyNES app's Library.",
+                  "OK", NULL, NULL);
+        return;
+    }
     if (!fs() || !fs()->read || !fs()->write)
