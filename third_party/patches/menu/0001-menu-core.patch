@@ -287,6 +287,13 @@ always @(posedge clk) begin
                             core_config <= {data_reg[23:0], rx_data};
                         end
                     end
+`ifndef MENU_CORE
+                    // TinyTang menu core: no legacy page, so the cursor and
+                    // print commands have nothing to address.  They are the
+                    // only writers of the page store, and the store is not
+                    // built; leaving them in would drive wires that lead
+                    // nowhere.  Command 8 below still sets the overlay -- the
+                    // wide layer is gated on it.
                     4: case (data_cnt)              // cursor
                         0: cursor_x <= rx_data;
                         1: cursor_y <= rx_data;
@@ -301,6 +308,7 @@ always @(posedge clk) begin
                             we <= 1;
                         end
                     end
+`endif
                     6: begin
                         rom_loading_reg <= rx_data;
                         recv_state <= RECV_IDLE;    // Single byte command
@@ -709,6 +717,14 @@ always @(posedge clk) begin
 end
 
 // text display
+`ifdef MENU_CORE
+// TinyTang menu core: there is no legacy page.  Nothing draws it, so the
+// compositor's overlay branch -- the one PROT-008 describes -- has no source,
+// and what it shows when the overlay is up and the wide layer is not is this
+// constant.  Black instead of a baked-in logo, by construction rather than by
+// an `osd clear` someone has to remember to send.
+assign overlay_color = 15'd0;
+`else
 `ifndef SIM
 wire [31:0] reg_char_di = {8'b0, x_wr, y_wr, char_wr};
 wire [3:0] reg_char_we = {4{we}};
@@ -719,5 +735,6 @@ textdisp #(.COLOR_LOGO(COLOR_LOGO)) disp (
     .reg_char_di(reg_char_di), .reg_char_we(reg_char_we)
 );
 `endif
+`endif
 
 endmodule
