+// The keyboard link's report, on its way up to the BL616.
+//
+// Driven by the link where a board has one and tied off where it does not, so
+// the iosys port is always connected and a board without a keyboard link needs
+// no special case.  The six usage codes are packed into one bus, key 0 in the
+// low byte, which is the order the receiver reports them in.
+//
+// Declared here rather than next to the iosys instantiation below because the
+// patches this project carries are anchored on that region, and an insertion
+// inside a hunk's context makes them stop applying.  Nothing here is near one.
+wire [7:0]  link_kbd_mods;
+wire [47:0] link_kbd_keys;
+`ifdef USB1
+assign link_kbd_mods = link_mods;
+assign link_kbd_keys = {link_keys[5], link_keys[4], link_keys[3],
+                        link_keys[2], link_keys[1], link_keys[0]};
+`else
+assign link_kbd_mods = 8'd0;
+assign link_kbd_keys = 48'd0;
+`endif
+
 
 // Main NES machine
 NES nes(
@@ -394,6 +415,7 @@ iosys_bl616 #(.COLOR_LOGO(15'b01100_00000_01000), .FREQ(21_492_000), .CORE_ID(1)
