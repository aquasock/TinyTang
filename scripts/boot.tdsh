#!/bin/tdsh
# boot.tdsh — what the board does when it powers up.
#
# Copy this to /root/scripts/boot.tdsh on the card to have the Tang come up as
# TinyDesk rather than as a prompt.  The firmware runs that one path at
# startup, through the same shell, so everything here is ordinary shell and the
# paths are the shell's.
#
# Nothing is reflashed to change what the board boots into: remove or rename
# the file and it goes back to a plain prompt.  If a step here fails the prompt
# still comes up afterwards, which is where the reason will be printed.
#
#     tools/tinytang_put.py scripts/boot.tdsh /root/scripts/boot.tdsh
#
# The cycle this sets up, mirrored on HDMI and configured VGA:
#
#   tangload   put a core in, so there is a raster for the layer to sit over
#   osd clear  blank the core's own text page, which a reset core shows
#   osd desk   mirror this session onto the desktop layer, so the screen shows it
#
# and then it stops.  The board is left showing its own console on the display,
# the way a machine of the period came up at a prompt, and bringing the desktop
# up is a thing the user types -- `desktop` enables the layer itself and turns
# the mirror off on its way past.
#
# The desktop core hosts TinyDesk without a machine running behind it. F12
# switches between the desktop layer and an empty frame. Its VGA sockets follow
# /tinytang.ini automatically, just as Phosphor does. The first version supports
# none or a complete vga_j1/vga_j2 pair; other modules remain released at boot.
# Build it with tools/build_desktop_core_open.sh, as BUILDING.md describes.
# The core that boots is the one carrying the PMOD UART.  Desktop ABI 1.6
# accepts every socket word the older build did -- none, oledrgb, a complete
# VGA pair -- and adds personality 8, the LoRa UART, so a card whose
# /tinytang.ini says `layout = lora` gets its radio from power-up instead of
# after a manual tangload.  The older image stays as the fallback for a card
# that does not carry the newer one.
CORE=/root/cores/console138k/tinytang-lora.bin
if test ! -f "$CORE"
    CORE=/root/cores/console138k/tinytang.bin
endif

# The core is named at the "loaded" line below, not up here.  Until tangload has
# programmed the FPGA the board has no raster, and `osd desk on` starts showing
# the console from that point rather than replaying it, so anything printed
# before the core is in is invisible on the display.  It is only ever seen by
# someone already attached to the USB console.

# Drop the layer before touching the core.
#
# Programming the FPGA from underneath a live overlay leaves the overlay
# asserted over whatever the new core draws, and a core that cannot draw the
# layer falls through to the legacy page: a black screen with the core's logo
# on it, with the game running invisibly behind it.  That is what made a
# cartridge launched this way look like a ROM that had not loaded.  Harmless at
# power-up, where nothing is asserted yet, and necessary when either script is
# run from a live desktop.
osd desk off

if test -f "$CORE"
    echo "boot: loading $CORE"
    tangload "$CORE"
    if $? != 0
        echo "boot: the core did not load; leaving the prompt"
        return 0
    endif
    fpga
else
    echo "boot: no core at $CORE; leaving the prompt"
    return 0
endif

# Retained for scripts that select a core with the legacy text page.
# The desktop core has no such page; its background starts black.
osd clear

# Mirror this session onto the desktop *layer* -- the 80x45 grid with per-cell
# colour that the desktop itself draws on, fed by the console tap.  The board
# has no display hardware of its own, so this is what puts the console on the
# screen: from here the display shows the prompt, and `desktop` is a thing the
# user asks for rather than the thing that arrives first.
osd desk on

# Stop here, at a loaded core, a displayed prompt and a live console.  The
# desktop is the only thing that draws into the layer as a window manager, so
# starting it from here would take the console before the user asked.
echo "boot: core loaded - type 'desktop' to bring up TinyDesk"

# The mouse works at this prompt too: the wheel scrolls the shell's history and
# a left click presses Enter.  Wheel up once recalls the last command and a
# click runs it, which is the shortest way back to the desktop.  The history is
# the shell's own file, so it starts empty and the wheel has nothing to recall
# until a command has been run once.
echo "boot: mouse: wheel scrolls history, click runs the line"

# A fresh card ships no Bluetooth pairings, and this desktop has no other input:
# there is no wired keyboard port, and the two USB-A sockets belong to the cores
# rather than to the console.  With nothing paired the user is looking at a
# console they cannot type into, so say what to do on the display, which is the
# one place they are certain to be looking.
if test ! -f /root/ble/bonds.bin
    echo "boot: no Bluetooth keyboard or mouse is paired."
    echo "boot: connect a PC to the Tang's USB-C OTG console port and run:"
    echo "boot:     blekbd pair      (put the keyboard in pairing mode first)"
    echo "boot:     blemouse pair"
endif
