#!/bin/tdsh
# boot.tdsh — what the board does when it powers up.
#
# Copy this to /scripts/boot.tdsh on the card to have the Tang come up as
# TinyDesk rather than as a prompt.  The firmware runs that one path at
# startup, through the same shell, so everything here is ordinary shell and the
# paths are the shell's.
#
# Nothing is reflashed to change what the board boots into: remove or rename
# the file and it goes back to a plain prompt.  If a step here fails the prompt
# still comes up afterwards, which is where the reason will be printed.
#
#     tools/tinytang_put.py scripts/boot.tdsh /scripts/boot.tdsh
#
# The cycle this sets up, all on the HDMI output:
#
#   tangload   put a core in, so there is a raster for the layer to sit over
#   osd clear  blank the core's own text page, which a reset core shows
#   osd desk   mirror this session onto the desktop layer, so the screen shows it
#
# and then it stops.  The board is left showing its own console on the display,
# the way a machine of the period came up at a prompt, and bringing the desktop
# up is a thing the user types -- `desktop` enables the layer itself and turns
# the mirror off on its way past.
#
# The board boots the menu core, which has no machine of its own: F12 (or L
# on controller 1) switches between TinyDesk and the core, and on this core
# the core's side is an empty frame.  A game is a cartridge launched from the
# console or the desktop -- boot-cart.tdsh loads the NES core for it -- and F12
# switches between the game and TinyDesk the same way.

# The core is the menu core: this project's patched nestang with the NES
# machine left out (third_party/patches/menu/, built by
# tools/build_menu_core.sh), so TinyDesk has a host of its own rather than an
# idle emulator.  It has to be a patched core.  The desktop layer is three
# commands the stock nestang does not implement -- it consumes them as unknown
# frame types and ignores them, which is exactly what keeps it working -- so
# loading /cores/console138k/nestang.bin here would leave 'osd desk on' talking
# to a core that cannot hear it, and the screen black with no error anywhere.
# Nothing below falls through to the desktop on a failure.  The desktop takes
# the console, so starting it with no core, or with no layer, would leave a
# black screen and no prompt -- a boot that looks broken and cannot be typed
# at, which is the worst possible place to discover a wrong path.
CORE=/cores/console138k/nestang-menu.bin

# Drop the layer before touching the core.
#
# Programming the FPGA from underneath a live overlay leaves the overlay
# asserted over whatever the new core draws, and a core that cannot draw the
# layer falls through to the legacy page: a black screen with the core's logo
# on it, with the game running invisibly behind it.  That is what made a
# cartridge launched this way look like a ROM that had not loaded.  Harmless at
# power-up, where nothing is asserted yet, and necessary when either script is
# run from a live desktop.
osd desk off

if test -f "$CORE"
    echo "boot: loading $CORE"
    tangload "$CORE"
    if $? != 0
        echo "boot: the core did not load; leaving the prompt"
        return 0
    endif
    fpga
else
    echo "boot: no core at $CORE; leaving the prompt"
    return 0
endif

# Blank the core's own text page before the layer comes up.
#
# A core comes out of reset with its overlay on, and while the desktop layer is
# still off the compositor shows that page instead of the desktop -- and the
# page's store is never initialised, so what shows is its power-on contents.
# Clearing it here makes the gap between the core loading and the desktop
# painting blank rather than stray characters.
osd clear

# Mirror this session onto the core's own text page.  The board has no display
# hardware, so this is what puts the console on the screen: from here the
# display shows the prompt, not the core's idle logo, and `desktop` is a thing
# the user asks for rather than the thing that arrives first.  `desktop` stops
# it as it takes the screen.
# Mirror this session onto the desktop *layer* -- the 80x45 grid with per-cell
# colour that the desktop itself draws on, fed by the console tap.  This is what
# puts the console on the display, and it is why the mirror looks like TinyDesk
# rather than like the core's own 32x28 page: `osd term` draws the latter, with
# nand2mario's font, one flat colour and the core's baked-in logo.
osd desk on

# Stop here, at a loaded core, a displayed prompt and a live console.  The
# desktop is the only thing that draws into the layer as a window manager, so
# starting it from here would take the console before the user asked.
echo "boot: core loaded; type 'desktop' to bring up TinyDesk"
