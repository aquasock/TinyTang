#!/bin/tdsh
# phosphor.tdsh - load the merged Phosphor core and enable its oscilloscope.
#
# Run it from the console prompt, or from the desktop -- right-click its icon
# and choose Run -- or from the Terminal:
#
#   tdsh run /scripts/phosphor.tdsh
#
# Choose a track in the desktop's Phosphor app after launching. To start a
# track automatically, set FILE in the session first; tdsh run passes no
# arguments, but the script inherits the session's variables:
#
#   FILE="/music/Fleetwood Mac - Landslide.mp3"; tdsh run /scripts/phosphor.tdsh
#
# The core carries the TinyDesk layer, so this works the way castlevania.tdsh
# does: the desktop stays up across the load, the screen is handed to the
# oscilloscope, and F12 switches between it and TinyDesk. An optional track is
# started without waiting, so the shell comes straight back and the core stays
# loaded after the track ends -- loading another core is what replaces it.
# Left-alt held turns the keyboard into the pointer while TinyDesk is shown.
# PMOD selection comes only from /tang.ini, applied automatically by tangload.
CORE=/cores/console138k/phosphortang.bin
PLAYER=/ae350/resident.tpi

echo "phosphor: core  $CORE"

if test -f "$CORE"
    echo "phosphor: core image found"
else
    echo "phosphor: no core image at $CORE"
    return 1
endif
if test -f "$PLAYER"
    echo "phosphor: player found"
else
    echo "phosphor: no AE350 player at $PLAYER"
    return 1
endif
if "$FILE" != ""
    if test -f "$FILE"
        echo "phosphor: file  $FILE"
    else
        echo "phosphor: no file at $FILE"
        return 1
    endif
endif

echo "phosphor: programming the FPGA"
tangload "$CORE"
if $? != 0
    echo "phosphor: the core did not load"
    return 1
endif

echo "phosphor: probing the link"
fpga
if $? != 0
    echo "phosphor: the core is not answering on the UART; not playing"
    return 1
endif

# The PMOD sockets were declared by tangload from /tang.ini (`tangini` shows
# what it says); the core powers up with both released.

# The canonical merged image includes the stereo XY oscilloscope. Enable it
# with medium trails and glow; this does not change the socket declaration.
phosphor poke 0xac 0xb
if $? != 0
    echo "phosphor: the oscilloscope could not be enabled"
    return 1
endif

# The core comes out of configuration with its overlay on, which in this core
# shows the TinyDesk layer; hand the screen to the player instead.  F12 brings
# TinyDesk back.
osd off
if $? != 0
    echo "phosphor: the screen could not be handed to the oscilloscope"
    return 1
endif

if "$FILE" != ""
    echo "phosphor: playing $FILE"
    phosphor play "$FILE" nowait
    if $? != 0
        echo "phosphor: playback did not start"
        return 1
    endif
else
    echo "phosphor: ready; press F12 and choose a track in the Phosphor app"
endif

echo "phosphor: up"
return 0
