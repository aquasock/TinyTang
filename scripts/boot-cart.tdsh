#!/bin/tdsh
# boot-cart.tdsh — boot a cartridge in one command.
#
# The three-step cycle, with the checks that make it safe to run blind:
# program the FPGA with a core, prove the core is answering on the UART, then
# stream a ROM into it and let it start.
#
#     tdsh run /scripts/boot-cart.tdsh
#
# Both paths default to the NES pair. To use another core or game, set the
# variable in the session first -- `tdsh run` passes no arguments to a script,
# but the script inherits the session's variables:
#
#     ROM=/roms/other.nes; tdsh run /scripts/boot-cart.tdsh
#
# The core default is the patched image rather than the stock one, because on
# this board the patched image is the NES core: it carries the keyboard link
# and the desktop layer, and the stock one carries neither.  Loading the stock
# core here would cost the keyboard its input until the next reboot.
#
# The probe between the two loads is the point of the script: streaming a ROM
# into a core that is not listening is a second of UART traffic that vanishes
# with no error anywhere, and the symptom is a black screen that looks like a
# video fault.

if "$CORE" == ""
    CORE=/cores/console138k/nestang-desk.bin
endif
if "$ROM" == ""
    ROM=/roms/castlevania.nes
endif

# The desk layer stays up across the load, so that F12 -- the key reserved
# for switching between TinyDesk and the core -- still works once the game is
# running; with the layer off nothing watches the keyboard.  nesload clears
# the overlay to hand the screen to the game, and the layer's re-arm after
# tangload restores the overlay rather than forcing it on, which is what once
# put the core's legacy page back over a running game.

echo "boot-cart: core  $CORE"
echo "boot-cart: rom   $ROM"

if test -f "$CORE"
    echo "boot-cart: core image found"
else
    echo "boot-cart: no core image at $CORE"
    return 1
endif
if test -f "$ROM"
    echo "boot-cart: rom found"
else
    echo "boot-cart: no rom at $ROM"
    return 1
endif

echo "boot-cart: programming the FPGA"
tangload "$CORE"
if $? != 0
    echo "boot-cart: the core did not load"
    return 1
endif

echo "boot-cart: probing the link"
fpga
if $? != 0
    echo "boot-cart: the core is not answering on the UART; not streaming"
    return 1
endif

# Blank the core's own text page.  After tangload the core is back with its
# overlay on, and the compositor shows that uninitialised page until the ROM
# takes the screen -- which on a core that never draws it is not a moment but
# the whole gap.
osd clear

echo "boot-cart: streaming the rom"
nesload "$ROM"
if $? != 0
    echo "boot-cart: the rom did not load"
    return 1
endif

echo "boot-cart: up"
return 0
