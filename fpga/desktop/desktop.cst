// UART to BL616
IO_LOC "UART_RXD" V14;
IO_LOC "UART_TXD" U15;
IO_PORT "UART_RXD" IO_TYPE=LVCMOS33;
IO_PORT "UART_TXD" IO_TYPE=LVCMOS33;

// The I2C bus on the populated USB-A port, whose data pair is the only one
// that reaches the FPGA on a stock dock (BRD-003): SDA on D+ (H13), SCL on D-
// (G13), as TinyNES and TinyGBC wire their first Wii controller.  The adapter
// on the port carries the bus's pull-ups and divides against the dock's 15K
// pull-downs; the internal pull-ups match TinyNES's pins.
IO_LOC  "usb_sda" H13;
IO_PORT "usb_sda" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC  "usb_scl" G13;
IO_PORT "usb_scl" PULL_MODE=UP IO_TYPE=LVCMOS33;

