// UART to BL616
IO_LOC "UART_RXD" V14;
IO_LOC "UART_TXD" U15;
IO_PORT "UART_RXD" IO_TYPE=LVCMOS33;
IO_PORT "UART_TXD" IO_TYPE=LVCMOS33;

// USB1 and USB2 (usb1 is on the left)
// TinyTang: these are host data lines, and the board provides no pull of its
// own here, so an empty socket leaves the pin floating -- which on an FPGA
// input means it oscillates, and the receiver's edge counter then watches a
// port with nothing in it manufacture traffic.  A pull-down is what a USB host
// port is meant to have (15K, USB 2.0 section 7.1.1.1) and it is what the
// primer25k board file already asks for on the same pins.  With it, an empty
// socket reads low and quiet, and a keyboard's D+ pull-up still wins easily.
IO_LOC  "usb1_dp" H13;
IO_PORT "usb1_dp" PULL_MODE=DOWN IO_TYPE=LVCMOS33;
IO_LOC  "usb1_dn" G13;
IO_PORT "usb1_dn" PULL_MODE=DOWN IO_TYPE=LVCMOS33;
IO_LOC  "usb2_dp" M15;
IO_PORT "usb2_dp" PULL_MODE=DOWN IO_TYPE=LVCMOS33;
IO_LOC  "usb2_dn" M16;
IO_PORT "usb2_dn" PULL_MODE=DOWN IO_TYPE=LVCMOS33;

