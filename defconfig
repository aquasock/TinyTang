# TinyTang SDK configuration for the upstream Bouffalo SDK (Kconfig), the
# counterpart of proj.conf, which the older fork SDK reads.  See proj.conf for
# why each option is set.
CONFIG_FREERTOS =y
CONFIG_BFLB_LOG =n
CONFIG_NEWLIB_FATFS =n
CONFIG_CHERRYUSB =y
CONFIG_CHERRYUSB_HOST =y
CONFIG_CHERRYUSB_DEVICE =y
CONFIG_CHERRYUSB_DEVICE_CDC =y
CONFIG_BLUETOOTH =y
CONFIG_BTBLECONTROLLER_LIB =ble1m10s1bredr0
CONFIG_RF =y
CONFIG_BLE_USE_MAC2 =n
CONFIG_DISABLE_BT_HOST_PRIVACY =y
CONFIG_BT_DEBUG_MONITOR =y
CONFIG_FATFS =y
CONFIG_BSP_SDH_SDCARD =y
CONFIG_FATFS_SDH_SDCARD =y
